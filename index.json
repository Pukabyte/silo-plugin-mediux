{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "community.mediux",
        "version": "0.1.18",
        "silo_api_version": "v1",
        "presentation": {
          "display_name": "Mediux Artwork",
          "summary": "Artwork from Mediux for TMDB and TVDB identified media.",
          "description_markdown": "Community Mediux artwork provider. It supplies remote Mediux URLs; Silo controls local or S3 artwork caching.",
          "setup_markdown": "Configure a Mediux API token, then put **Mediux Artwork** first for artwork. Other metadata providers can fill text and IDs; TMDB and TVDB IDs bootstrap Mediux lookup.",
          "homepage_url": "https://mediux.pro",
          "publisher_name": "Pukabyte",
          "source_url": "https://github.com/Pukabyte/silo-plugin-mediux",
          "support_url": "https://github.com/Pukabyte/silo-plugin-mediux/issues",
          "changelog_url": "https://github.com/Pukabyte/silo-plugin-mediux/releases",
          "publisher_url": "https://github.com/Pukabyte",
          "license_spdx": "AGPL-3.0-or-later"
        },
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "metadata_provider.v1",
            "id": "mediux",
            "display_name": "Mediux Artwork",
            "description": "Mediux artwork for movies and series.",
            "metadata": {
              "default_priority": {
                "movie": 1,
                "series": 1,
                "season": 1,
                "episode": 1
              },
              "lookup_provider_ids": [
                "tmdb",
                "tvdb"
              ],
              "image_lookup_provider_ids": [
                "tmdb",
                "tvdb"
              ]
            }
          },
          {
            "type": "image_resolver.v1",
            "id": "mediux",
            "display_name": "Mediux Images",
            "description": "Resolves mediux:// artwork paths.",
            "metadata": {
              "schemes": [
                "mediux"
              ],
              "priority": 100
            }
          },
          {
            "type": "http_routes.v1",
            "id": "creator-settings",
            "display_name": "Mediux Creator Lookup",
            "description": "Admin-only public creator username search for artwork preferences."
          }
        ],
        "global_config_schema": [
          {
            "key": "settings",
            "title": "Mediux settings",
            "required": true,
            "json_schema": "{\"type\":\"object\",\"required\":[\"api_token\"],\"properties\":{\"api_token\":{\"type\":\"string\",\"minLength\":1}}}",
            "admin_form": {
              "fields": [
                {
                  "key": "api_token",
                  "label": "Mediux API token",
                  "control": 3,
                  "secret": true,
                  "required": true
                }
              ]
            },
            "description": "Configure your API token here. Use Mediux artwork settings in the plugin menu or admin sidebar for creator priorities and artwork preferences."
          },
          {
            "key": "collection_connection",
            "title": "Collection connection",
            "required": false,
            "description": "Optional connection for plugin-owned collection artwork management. Use a dedicated administrator API key for this Silo instance; the host stores it encrypted. The plugin obtains this host's internal API URL through the SDK.",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"api_key\":{\"type\":\"string\",\"minLength\":1}},\"additionalProperties\":false}",
            "admin_form": {
              "fields": [
                {
                  "key": "api_key",
                  "label": "Silo API key",
                  "control": 3,
                  "secret": true,
                  "required": false
                }
              ]
            }
          }
        ],
        "http_routes": [
          {
            "id": "creators",
            "method": "GET",
            "path": "/creators",
            "access": "admin"
          },
          {
            "id": "artwork-settings",
            "method": "GET",
            "path": "/settings",
            "access": "admin",
            "navigable": true,
            "navigation_label": "Mediux artwork settings",
            "navigation_kind": "admin"
          },
          {
            "id": "get-artwork-settings",
            "method": "GET",
            "path": "/settings/config",
            "access": "admin"
          },
          {
            "id": "save-artwork-settings",
            "method": "PUT",
            "path": "/settings/config",
            "access": "admin"
          },
          {
            "id": "collection-artwork",
            "method": "GET",
            "path": "/collection-artwork",
            "access": "admin"
          },
          {
            "id": "collection-manager",
            "method": "GET",
            "path": "/collections",
            "access": "admin",
            "navigable": false
          },
          {
            "id": "collection-manager-style",
            "method": "GET",
            "path": "/ui.css",
            "access": "admin"
          },
          {
            "id": "collection-catalog",
            "method": "GET",
            "path": "/collections/catalog",
            "access": "admin"
          },
          {
            "id": "collection-item",
            "method": "GET",
            "path": "/collections/item",
            "access": "admin"
          },
          {
            "id": "collection-apply-cover",
            "method": "POST",
            "path": "/collections/cover",
            "access": "admin"
          },
          {
            "id": "mediux-set-manager",
            "method": "GET",
            "path": "/sets",
            "access": "admin",
            "navigable": false
          },
          {
            "id": "mediux-set-catalog",
            "method": "GET",
            "path": "/sets/catalog",
            "access": "admin"
          },
          {
            "id": "mediux-set-preferences-read",
            "method": "GET",
            "path": "/sets/preferences",
            "access": "admin"
          },
          {
            "id": "mediux-set-preferences-save",
            "method": "PUT",
            "path": "/sets/preferences",
            "access": "admin"
          },
          {
            "id": "mediux-set-library-search",
            "method": "GET",
            "path": "/sets/items",
            "access": "admin"
          },
          {
            "id": "mediux-set-library-item",
            "method": "GET",
            "path": "/sets/item",
            "access": "admin"
          },
          {
            "id": "mediux-collection-discovery",
            "method": "GET",
            "path": "/collections/discover",
            "access": "admin"
          },
          {
            "id": "mediux-set-plan",
            "method": "POST",
            "path": "/sets/plan",
            "access": "admin"
          },
          {
            "id": "mediux-set-apply",
            "method": "POST",
            "path": "/sets/apply",
            "access": "admin"
          },
          {
            "id": "artwork-manager",
            "method": "GET",
            "path": "/artwork",
            "access": "admin",
            "navigable": true,
            "navigation_label": "Artwork Manager",
            "navigation_kind": "admin"
          }
        ]
      },
      "repo_url": "https://github.com/Pukabyte/silo-plugin-mediux",
      "checksums_url": "https://github.com/Pukabyte/silo-plugin-mediux/releases/download/v0.1.18/checksums.txt",
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/Pukabyte/silo-plugin-mediux/releases/download/v0.1.18/plugin-linux-amd64",
          "checksum": "cfa05f32dbc21b9f8fdcf9b513c36c13d5989fcf322f0f5de93bd110b38290da"
        },
        "linux/arm64": {
          "url": "https://github.com/Pukabyte/silo-plugin-mediux/releases/download/v0.1.18/plugin-linux-arm64",
          "checksum": "962bfb6cfcee1aafc241e6d3e254f16f2287d7a73dac9edc4abdc6e56b45bad4"
        },
        "darwin/arm64": {
          "url": "https://github.com/Pukabyte/silo-plugin-mediux/releases/download/v0.1.18/plugin-darwin-arm64",
          "checksum": "5e4d718056c6e2c90fece7421637cab1be0d7ce1dc6ea2e8fc9aecd13743f2d3"
        }
      }
    }
  ]
}
